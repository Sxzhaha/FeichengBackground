<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.binZhou.ld.mapper.AgriChatSessionMapper">

    <resultMap type="com.ruoyi.binZhou.ld.domain.AgriChatSession" id="AgriChatSessionResult">
        <result property="sessionId"    column="session_id"    />
        <result property="userId"       column="user_id"       />
        <result property="title"        column="title"         />
        <result property="delFlag"      column="del_flag"      />
        <result property="createTime"   column="create_time"   />
        <result property="updateTime"   column="update_time"   />
    </resultMap>

    <select id="selectSessionList" parameterType="com.ruoyi.binZhou.ld.domain.AgriChatSession" resultMap="AgriChatSessionResult">
        select session_id, user_id, title, create_time, update_time from agri_chat_session
        where del_flag = '0'
        <if test="userId != null "> and user_id = #{userId}</if>
        order by update_time desc
    </select>

    <insert id="insertSession" parameterType="com.ruoyi.binZhou.ld.domain.AgriChatSession" useGeneratedKeys="true" keyProperty="sessionId">
        insert into agri_chat_session
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="title != null">title,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="title != null">#{title},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateSession" parameterType="com.ruoyi.binZhou.ld.domain.AgriChatSession">
        update agri_chat_session
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null">title = #{title},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where session_id = #{sessionId}
    </update>

    <update id="deleteSessionById" parameterType="Long">
        update agri_chat_session set del_flag = '2' where session_id = #{sessionId}
    </update>

</mapper>