<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.binZhou.xwq.mapper.UserDefaultScopeMapper">
    
    <resultMap type="UserDefaultScope" id="UserDefaultScopeResult">
        <result property="scopeId"    column="scope_id"    />
        <result property="userId"    column="user_id"    />
        <result property="parkId"    column="park_id"    />
        <result property="areaId"    column="area_id"    />
        <result property="deviceId"    column="device_id"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectUserDefaultScopeVo">
        select scope_id, user_id, park_id, area_id, device_id, status, create_by, create_time, update_by, update_time, remark from xwq_user_default_scope
    </sql>

    <select id="selectUserDefaultScopeList" parameterType="UserDefaultScope" resultMap="UserDefaultScopeResult">
        <include refid="selectUserDefaultScopeVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="parkId != null "> and park_id = #{parkId}</if>
            <if test="areaId != null "> and area_id = #{areaId}</if>
            <if test="deviceId != null "> and device_id = #{deviceId}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectUserDefaultScopeByScopeId" parameterType="Long" resultMap="UserDefaultScopeResult">
        <include refid="selectUserDefaultScopeVo"/>
        where scope_id = #{scopeId}
    </select>

    <insert id="insertUserDefaultScope" parameterType="UserDefaultScope" useGeneratedKeys="true" keyProperty="scopeId">
        insert into xwq_user_default_scope
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="parkId != null">park_id,</if>
            <if test="areaId != null">area_id,</if>
            <if test="deviceId != null">device_id,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="parkId != null">#{parkId},</if>
            <if test="areaId != null">#{areaId},</if>
            <if test="deviceId != null">#{deviceId},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateUserDefaultScope" parameterType="UserDefaultScope">
        update xwq_user_default_scope
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="parkId != null">park_id = #{parkId},</if>
            <if test="areaId != null">area_id = #{areaId},</if>
            <if test="deviceId != null">device_id = #{deviceId},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null and createBy != ''">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where scope_id = #{scopeId}
    </update>

    <update id="updateUserDefaultScopeCurrent" parameterType="UserDefaultScope">
        update xwq_user_default_scope
        set user_id = #{userId,jdbcType=BIGINT},
            park_id = #{parkId,jdbcType=BIGINT},
            area_id = #{areaId,jdbcType=BIGINT},
            device_id = #{deviceId,jdbcType=BIGINT},
            status = #{status,jdbcType=CHAR},
            update_by = #{updateBy,jdbcType=VARCHAR},
            update_time = #{updateTime,jdbcType=TIMESTAMP},
            remark = #{remark,jdbcType=VARCHAR}
        where scope_id = #{scopeId}
    </update>

    <delete id="deleteUserDefaultScopeByScopeId" parameterType="Long">
        delete from xwq_user_default_scope where scope_id = #{scopeId}
    </delete>

    <delete id="deleteUserDefaultScopeByScopeIds" parameterType="String">
        delete from xwq_user_default_scope where scope_id in 
        <foreach item="scopeId" collection="array" open="(" separator="," close=")">
            #{scopeId}
        </foreach>
    </delete>
</mapper>
