    <sql id="selectAiImageVo">
        select image_id, image_name, image_url, image_result_url, image_mask_url, image_ai_type, image_source, image_source_id, image_width, image_height, image_size, image_format, park_id, plot_id, device_id, longitude, latitude, image_status, image_a, image_b, image_c, image_d, image_e, image_f, image_g, image_h, image_i, image_j, create_by, create_time, update_by, update_time, remark from xwq_ai_image
    </sql>

    <select id="selectAiImageList" parameterType="AiImage" resultMap="AiImageResult">
        <include refid="selectAiImageVo"/>
        <where>  
            <if test="imageName != null  and imageName != ''"> and image_name like concat('%', #{imageName}, '%')</if>
            <if test="imageUrl != null  and imageUrl != ''"> and image_url = #{imageUrl}</if>
