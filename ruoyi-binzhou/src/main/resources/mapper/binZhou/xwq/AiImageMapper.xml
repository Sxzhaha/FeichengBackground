    <delete id="deleteAiImageByImageId" parameterType="Long">
        delete from xwq_ai_image where image_id = #{imageId}
    </delete>

    <delete id="deleteAiImageByImageIds" parameterType="String">
        delete from xwq_ai_image where image_id in 
        <foreach item="imageId" collection="array" open="(" separator="," close=")">
            #{imageId}
        </foreach>
    </delete>


    <!-- 查询待自动识别图片 -->
    <select id="selectPendingAutoRecognizeImages" resultMap="AiImageResult">
        <include refid="selectAiImageVo"/>
        where image_status = 0
        and image_ai_type is not null
        and image_ai_type != ''
        order by image_id asc
        limit #{limit}
    </select>

    <!-- 抢占图片，避免重复识别 -->
    <update id="claimImageForRecognize">
        update xwq_ai_image
        set image_status = 1
        where image_id = #{imageId}
          and image_status = 0
    </update>

    <!-- 更新图片识别状态 -->
    <update id="updateImageStatusById">
        update xwq_ai_image
        set image_status = #{imageStatus}
        where image_id = #{imageId}
    </update>


    <!-- 将 image_record 中的摄像头抓拍图片同步到 xwq_ai_image，作为病虫害待识别图片 -->
    <insert id="insertDiseaseImageFromImageRecord">
        insert into xwq_ai_image
        (
            image_name,
            image_url,
            image_ai_type,
            image_source,
            image_source_id,
            image_size,
            image_format,
            park_id,
            plot_id,
            device_id,
            image_status,
            image_a,
            image_b
        )
        select
            concat('camera_', r.id, '_', substring_index(r.url, '/', -1)) as image_name,
            r.url as image_url,
            'disease' as image_ai_type,
            '摄像头' as image_source,
            r.id as image_source_id,
            r.file_size as image_size,
            lower(substring_index(r.url, '.', -1)) as image_format,
            a.park_id as park_id,
            a.area_id as plot_id,
            r.device_id as device_id,
            0 as image_status,
            #{cropType} as image_a,
            cast(l.location_id as char) as image_b
        from image_record r
        left join iot_device d on r.device_id = d.device_id
        left join location l on d.location_id = l.location_id
        left join area a on l.area_id = a.area_id
        where r.id = #{recordId}
          and not exists (
            select 1
            from xwq_ai_image i
            where i.image_source = '摄像头'
              and i.image_source_id = r.id
              and i.image_ai_type = 'disease'
        )
    </insert>
