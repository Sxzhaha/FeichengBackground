<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.binZhou.wr.mapper.WarningTemplateMapper">

    <resultMap type="WarningTemplate" id="WarningTemplateResult">
        <result property="id"    column="id"    />
        <result property="templateName"    column="template_name"    />
        <result property="warningType"    column="warning_type"    />
        <result property="parkId"    column="park_id"    />
        <result property="parkName"    column="park_name"    />
        <result property="areaId"    column="area_id"    />
        <result property="areaName"    column="area_name"    />
        <result property="locationId"    column="location_id"    />
        <result property="locationName"    column="location_name"    />
        <result property="cropName"    column="cropName"    />
        <result property="description"    column="description"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectWarningTemplateVo">
        select w.id, w.template_name, w.warning_type, w.park_id, w.area_id, w.location_id, w.cropName, w.description, w.status, w.create_by, w.create_time, w.update_time,
               p.park_name, a.area_name, l.location_name
        from wr_warning_template w
                 left join park p on w.park_id = p.park_id
                 left join area a on w.area_id = a.area_id
                 left join location l on w.location_id = l.location_id
    </sql>

    <select id="selectWarningTemplateList" parameterType="WarningTemplate" resultMap="WarningTemplateResult">
        <include refid="selectWarningTemplateVo"/>
        <where>
            <if test="templateName != null  and templateName != ''"> and w.template_name like concat('%', #{templateName}, '%')</if>
            <if test="warningType != null "> and w.warning_type = #{warningType}</if>
            <if test="parkId != null "> and w.park_id = #{parkId}</if>
            <if test="areaId != null "> and w.area_id = #{areaId}</if>
            <if test="locationId != null "> and w.location_id = #{locationId}</if>
            <if test="cropName != null "> and w.cropName = #{cropName}</if>
            <if test="description != null  and description != ''"> and w.description = #{description}</if>
            <if test="status != null "> and w.status = #{status}</if>
        </where>
    </select>

    <select id="selectWarningTemplateById" parameterType="Long" resultMap="WarningTemplateResult">
        <include refid="selectWarningTemplateVo"/>
        where w.id = #{id}
    </select>

    <insert id="insertWarningTemplate" parameterType="WarningTemplate" useGeneratedKeys="true" keyProperty="id">
        insert into wr_warning_template
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="templateName != null and templateName != ''">template_name,</if>
            <if test="warningType != null">warning_type,</if>
            <if test="parkId != null">park_id,</if>
            <if test="areaId != null">area_id,</if>
            <if test="locationId != null">location_id,</if>
            <if test="cropName != null">cropName,</if>
            <if test="description != null">description,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="templateName != null and templateName != ''">#{templateName},</if>
            <if test="warningType != null">#{warningType},</if>
            <if test="parkId != null">#{parkId},</if>
            <if test="areaId != null">#{areaId},</if>
            <if test="locationId != null">#{locationId},</if>
            <if test="cropName != null">#{cropName},</if>
            <if test="description != null">#{description},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateWarningTemplate" parameterType="WarningTemplate">
        update wr_warning_template
        <trim prefix="SET" suffixOverrides=",">
            <if test="templateName != null and templateName != ''">template_name = #{templateName},</if>
            <if test="warningType != null">warning_type = #{warningType},</if>
            <if test="parkId != null">park_id = #{parkId},</if>
            <if test="areaId != null">area_id = #{areaId},</if>
            <if test="locationId != null">location_id = #{locationId},</if>
            <if test="cropName != null">cropName = #{cropName},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWarningTemplateById" parameterType="Long">
        delete from wr_warning_template where id = #{id}
    </delete>

    <delete id="deleteWarningTemplateByIds" parameterType="String">
        delete from wr_warning_template where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>