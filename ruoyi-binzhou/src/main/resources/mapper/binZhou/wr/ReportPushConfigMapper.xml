<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.binZhou.wr.mapper.ReportPushConfigMapper">
    
    <resultMap type="ReportPushConfig" id="ReportPushConfigResult">
        <result property="configId"    column="config_id"    />
        <result property="userId"    column="user_id"    />
        <result property="userRole"    column="user_role"    />
        <result property="pushFrequency"    column="push_frequency"    />
        <result property="pushChannel"    column="push_channel"    />
        <result property="areaCode"    column="area_code"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectReportPushConfigVo">
        select config_id, user_id, user_role, push_frequency, push_channel, area_code, status, create_by, create_time, update_time from wr_report_push_config
    </sql>

    <select id="selectReportPushConfigList" parameterType="ReportPushConfig" resultMap="ReportPushConfigResult">
        <include refid="selectReportPushConfigVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="userRole != null  and userRole != ''"> and user_role = #{userRole}</if>
            <if test="pushFrequency != null  and pushFrequency != ''"> and push_frequency = #{pushFrequency}</if>
            <if test="pushChannel != null  and pushChannel != ''"> and push_channel = #{pushChannel}</if>
            <if test="areaCode != null  and areaCode != ''"> and area_code = #{areaCode}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectReportPushConfigByConfigId" parameterType="Long" resultMap="ReportPushConfigResult">
        <include refid="selectReportPushConfigVo"/>
        where config_id = #{configId}
    </select>

    <insert id="insertReportPushConfig" parameterType="ReportPushConfig" useGeneratedKeys="true" keyProperty="configId">
        insert into wr_report_push_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="userRole != null and userRole != ''">user_role,</if>
            <if test="pushFrequency != null">push_frequency,</if>
            <if test="pushChannel != null">push_channel,</if>
            <if test="areaCode != null">area_code,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="userRole != null and userRole != ''">#{userRole},</if>
            <if test="pushFrequency != null">#{pushFrequency},</if>
            <if test="pushChannel != null">#{pushChannel},</if>
            <if test="areaCode != null">#{areaCode},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateReportPushConfig" parameterType="ReportPushConfig">
        update wr_report_push_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userRole != null and userRole != ''">user_role = #{userRole},</if>
            <if test="pushFrequency != null">push_frequency = #{pushFrequency},</if>
            <if test="pushChannel != null">push_channel = #{pushChannel},</if>
            <if test="areaCode != null">area_code = #{areaCode},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where config_id = #{configId}
    </update>

    <delete id="deleteReportPushConfigByConfigId" parameterType="Long">
        delete from wr_report_push_config where config_id = #{configId}
    </delete>

    <delete id="deleteReportPushConfigByConfigIds" parameterType="String">
        delete from wr_report_push_config where config_id in 
        <foreach item="configId" collection="array" open="(" separator="," close=")">
            #{configId}
        </foreach>
    </delete>
</mapper>