<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.binZhou.wr.mapper.WarningTaskMapper">

    <resultMap type="WarningTask" id="WarningTaskResult">
        <result property="id"    column="id"    />
        <result property="taskName"    column="task_name"    />
        <result property="templateId"    column="template_id"    />
        <result property="templateName"  column="template_name"  />
        <result property="cronExpression"    column="cron_expression"    />
        <result property="monitorStartTime"    column="monitor_start_time"    />
        <result property="monitorEndTime"    column="monitor_end_time"    />
        <result property="dataSourceType"    column="data_source_type"    />
        <result property="dataSourceId"    column="data_source_id"    />
        <result property="queryConfigJson"    column="query_config_json"    />
        <result property="ruleSourceType"    column="rule_source_type"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="reservedField1"    column="reserved_field1"    />
        <result property="reservedField2"    column="reserved_field2"    />
    </resultMap>

    <sql id="selectWarningTaskVo">
        select id, task_name, template_id, cron_expression, monitor_start_time, monitor_end_time, data_source_type, data_source_id, query_config_json, rule_source_type, status, create_by, create_time, update_time, reserved_field1, reserved_field2 from wr_warning_task
    </sql>

    <select id="selectWarningTaskList" parameterType="WarningTask" resultMap="WarningTaskResult">
        select k.id, k.task_name, k.template_id, t.template_name, k.cron_expression, k.monitor_start_time, k.monitor_end_time, k.data_source_type, k.data_source_id, k.query_config_json, k.rule_source_type, k.status, k.create_by, k.create_time, k.update_time, k.reserved_field1, k.reserved_field2
        from wr_warning_task k
        left join wr_warning_template t on k.template_id = t.id
        <where>
            <if test="taskName != null  and taskName != ''"> and k.task_name like concat('%', #{taskName}, '%')</if>
            <if test="templateId != null "> and k.template_id = #{templateId}</if>
            <if test="cronExpression != null  and cronExpression != ''"> and k.cron_expression = #{cronExpression}</if>
            <if test="monitorStartTime != null "> and k.monitor_start_time = #{monitorStartTime}</if>
            <if test="monitorEndTime != null "> and k.monitor_end_time = #{monitorEndTime}</if>
            <if test="dataSourceType != null  and dataSourceType != ''"> and k.data_source_type = #{dataSourceType}</if>
            <if test="dataSourceId != null "> and k.data_source_id = #{dataSourceId}</if>
            <if test="queryConfigJson != null  and queryConfigJson != ''"> and k.query_config_json = #{queryConfigJson}</if>
            <if test="ruleSourceType != null  and ruleSourceType != ''"> and k.rule_source_type = #{ruleSourceType}</if>
            <if test="status != null  and status != ''"> and k.status = #{status}</if>
            <if test="reservedField1 != null  and reservedField1 != ''"> and k.reserved_field1 = #{reservedField1}</if>
            <if test="reservedField2 != null  and reservedField2 != ''"> and k.reserved_field2 = #{reservedField2}</if>
        </where>
    </select>

    <select id="selectWarningTaskById" parameterType="Long" resultMap="WarningTaskResult">
        <include refid="selectWarningTaskVo"/>
        where id = #{id}
    </select>

    <insert id="insertWarningTask" parameterType="WarningTask" useGeneratedKeys="true" keyProperty="id">
        insert into wr_warning_task
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">task_name,</if>
            <if test="templateId != null">template_id,</if>
            <if test="cronExpression != null">cron_expression,</if>
            <if test="monitorStartTime != null">monitor_start_time,</if>
            <if test="monitorEndTime != null">monitor_end_time,</if>
            <if test="dataSourceType != null">data_source_type,</if>
            <if test="dataSourceId != null">data_source_id,</if>
            <if test="queryConfigJson != null">query_config_json,</if>
            <if test="ruleSourceType != null and ruleSourceType != ''">rule_source_type,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="reservedField1 != null">reserved_field1,</if>
            <if test="reservedField2 != null">reserved_field2,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">#{taskName},</if>
            <if test="templateId != null">#{templateId},</if>
            <if test="cronExpression != null">#{cronExpression},</if>
            <if test="monitorStartTime != null">#{monitorStartTime},</if>
            <if test="monitorEndTime != null">#{monitorEndTime},</if>
            <if test="dataSourceType != null">#{dataSourceType},</if>
            <if test="dataSourceId != null">#{dataSourceId},</if>
            <if test="queryConfigJson != null">#{queryConfigJson},</if>
            <if test="ruleSourceType != null and ruleSourceType != ''">#{ruleSourceType},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="reservedField1 != null">#{reservedField1},</if>
            <if test="reservedField2 != null">#{reservedField2},</if>
        </trim>
    </insert>

    <update id="updateWarningTask" parameterType="WarningTask">
        update wr_warning_task
        <trim prefix="SET" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">task_name = #{taskName},</if>
            <if test="templateId != null">template_id = #{templateId},</if>
            <if test="cronExpression != null">cron_expression = #{cronExpression},</if>
            <if test="monitorStartTime != null">monitor_start_time = #{monitorStartTime},</if>
            <if test="monitorEndTime != null">monitor_end_time = #{monitorEndTime},</if>
            <if test="dataSourceType != null">data_source_type = #{dataSourceType},</if>
            <if test="dataSourceId != null">data_source_id = #{dataSourceId},</if>
            <if test="queryConfigJson != null">query_config_json = #{queryConfigJson},</if>
            <if test="ruleSourceType != null and ruleSourceType != ''">rule_source_type = #{ruleSourceType},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="reservedField1 != null">reserved_field1 = #{reservedField1},</if>
            <if test="reservedField2 != null">reserved_field2 = #{reservedField2},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWarningTaskById" parameterType="Long">
        delete from wr_warning_task where id = #{id}
    </delete>

    <delete id="deleteWarningTaskByIds" parameterType="String">
        delete from wr_warning_task where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>