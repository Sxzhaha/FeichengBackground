<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.iot.ld.mapper.AgriProductAlertConfigMapper">
    
    <resultMap type="AgriProductAlertConfig" id="AgriProductAlertConfigResult">
        <result property="id"    column="id"    />
        <result property="modelId"    column="model_id"    />
        <result property="deviceId"    column="device_id"    />
        <result property="productId"    column="product_id"    />
        <result property="productName"    column="product_name"    />
        <result property="modelName"    column="model_name"    />
        <result property="deviceName"    column="device_name"    />
        <result property="deviceSn"    column="device_sn"    />
        <result property="alertLevel"    column="alert_level"    />
        <result property="thresholdMin"    column="threshold_min"    />
        <result property="thresholdMax"    column="threshold_max"    />
        <result property="ruleDescription"    column="rule_description"    />
        <result property="isEnabled"    column="is_enabled"    />
        <result property="createTime"    column="create_time"    />
        <result property="creator"    column="creator"    />
        <result property="remark1"    column="remark1"    />
        <result property="remark2"    column="remark2"    />
    </resultMap>

    <sql id="selectAgriProductAlertConfigVo">
        select c.id, c.model_id, c.device_id, m.product_id, p.product_name, m.model_name,
               d.device_name, d.device_sn, c.alert_level, c.threshold_min, c.threshold_max,
               c.rule_description, c.is_enabled, c.create_time, c.creator, c.remark1, c.remark2
        from ld_agri_product_alert_config c
        left join iot_thing_model m on c.model_id = m.model_id
        left join iot_product p on m.product_id = p.product_id
        left join iot_device d on c.device_id = d.device_id
    </sql>

    <select id="selectAgriProductAlertConfigList" parameterType="AgriProductAlertConfig" resultMap="AgriProductAlertConfigResult">
        <include refid="selectAgriProductAlertConfigVo"/>
        <where>  
            <if test="modelId != null "> and c.model_id = #{modelId}</if>
            <if test="deviceId != null "> and c.device_id = #{deviceId}</if>
            <if test="productId != null "> and m.product_id = #{productId}</if>
            <if test="alertLevel != null  and alertLevel != ''"> and c.alert_level = #{alertLevel}</if>
            <if test="thresholdMin != null "> and c.threshold_min = #{thresholdMin}</if>
            <if test="thresholdMax != null "> and c.threshold_max = #{thresholdMax}</if>
            <if test="ruleDescription != null  and ruleDescription != ''"> and c.rule_description = #{ruleDescription}</if>
            <if test="isEnabled != null "> and c.is_enabled = #{isEnabled}</if>
            <if test="creator != null "> and c.creator = #{creator}</if>
            <if test="remark1 != null "> and c.remark1 = #{remark1}</if>
            <if test="remark2 != null  and remark2 != ''"> and c.remark2 = #{remark2}</if>
        </where>
    </select>
    
    <select id="selectAgriProductAlertConfigById" parameterType="Long" resultMap="AgriProductAlertConfigResult">
        <include refid="selectAgriProductAlertConfigVo"/>
        where c.id = #{id}
    </select>

    <insert id="insertAgriProductAlertConfig" parameterType="AgriProductAlertConfig" useGeneratedKeys="true" keyProperty="id">
        insert into ld_agri_product_alert_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="modelId != null">model_id,</if>
            <if test="deviceId != null">device_id,</if>
            <if test="alertLevel != null and alertLevel != ''">alert_level,</if>
            <if test="thresholdMin != null">threshold_min,</if>
            <if test="thresholdMax != null">threshold_max,</if>
            <if test="ruleDescription != null">rule_description,</if>
            <if test="isEnabled != null">is_enabled,</if>
            <if test="createTime != null">create_time,</if>
            <if test="creator != null">creator,</if>
            <if test="remark1 != null">remark1,</if>
            <if test="remark2 != null">remark2,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="modelId != null">#{modelId},</if>
            <if test="deviceId != null">#{deviceId},</if>
            <if test="alertLevel != null and alertLevel != ''">#{alertLevel},</if>
            <if test="thresholdMin != null">#{thresholdMin},</if>
            <if test="thresholdMax != null">#{thresholdMax},</if>
            <if test="ruleDescription != null">#{ruleDescription},</if>
            <if test="isEnabled != null">#{isEnabled},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="creator != null">#{creator},</if>
            <if test="remark1 != null">#{remark1},</if>
            <if test="remark2 != null">#{remark2},</if>
         </trim>
    </insert>

    <update id="updateAgriProductAlertConfig" parameterType="AgriProductAlertConfig">
        update ld_agri_product_alert_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="modelId != null">model_id = #{modelId},</if>
            device_id = #{deviceId},
            <if test="alertLevel != null and alertLevel != ''">alert_level = #{alertLevel},</if>
            <if test="thresholdMin != null">threshold_min = #{thresholdMin},</if>
            <if test="thresholdMax != null">threshold_max = #{thresholdMax},</if>
            <if test="ruleDescription != null">rule_description = #{ruleDescription},</if>
            <if test="isEnabled != null">is_enabled = #{isEnabled},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="creator != null">creator = #{creator},</if>
            <if test="remark1 != null">remark1 = #{remark1},</if>
            <if test="remark2 != null">remark2 = #{remark2},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAgriProductAlertConfigById" parameterType="Long">
        delete from ld_agri_product_alert_config where id = #{id}
    </delete>

    <delete id="deleteAgriProductAlertConfigByIds" parameterType="String">
        delete from ld_agri_product_alert_config where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
