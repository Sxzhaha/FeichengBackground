<mapper namespace="com.ruoyi.iot.ld.mapper.AgriWeatherForecastMapper">
    
    <resultMap type="AgriWeatherForecast" id="AgriWeatherForecastResult">
        <result property="id"    column="id"    />
        <result property="parkId"    column="park_id"    />
        <result property="fetchTime"    column="fetch_time"    />
        <result property="forecastDate"    column="forecast_date"    />
        <result property="tempMax"    column="temp_max"    />
