    <sql id="selectAgriWeatherForecastVo">
        select id, park_id, fetch_time, forecast_date, temp_max, temp_min, humidity_avg, wind_dir_day, wind_scale_day, precip_total, precip_prob, weather_text_day, weather_text_night, day_code, moon_code, forecast_type, remark1, remark2 from ld_agri_weather_forecast
    </sql>

    <select id="selectAgriWeatherForecastList" parameterType="AgriWeatherForecast" resultMap="AgriWeatherForecastResult">
        <include refid="selectAgriWeatherForecastVo"/>
        <where>  
            <if test="parkId != null  and parkId != ''"> and park_id = #{parkId}</if>
            <if test="fetchTime != null "> and fetch_time = #{fetchTime}</if>
            <if test="params != null and params.latest != null and params.latest == 'true'">
                and fetch_time = (select max(fetch_time) from ld_agri_weather_forecast f where f.park_id = ld_agri_weather_forecast.park_id)
            </if>
            <if test="forecastDate != null "> and forecast_date = #{forecastDate}</if>
            <if test="tempMax != null "> and temp_max = #{tempMax}</if>
            <if test="tempMin != null "> and temp_min = #{tempMin}</if>
            <if test="humidityAvg != null "> and humidity_avg = #{humidityAvg}</if>
            <if test="windDirDay != null  and windDirDay != ''"> and wind_dir_day = #{windDirDay}</if>
            <if test="windScaleDay != null  and windScaleDay != ''"> and wind_scale_day = #{windScaleDay}</if>
            <if test="precipTotal != null "> and precip_total = #{precipTotal}</if>
            <if test="precipProb != null "> and precip_prob = #{precipProb}</if>
            <if test="weatherTextDay != null  and weatherTextDay != ''"> and weather_text_day = #{weatherTextDay}</if>
            <if test="weatherTextNight != null  and weatherTextNight != ''"> and weather_text_night = #{weatherTextNight}</if>
            <if test="dayCode != null  and dayCode != ''"> and day_code = #{dayCode}</if>
            <if test="moonCode != null  and moonCode != ''"> and moon_code = #{moonCode}</if>
            <if test="forecastType != null "> and forecast_type = #{forecastType}</if>
            <if test="remark1 != null "> and remark1 = #{remark1}</if>
            <if test="remark2 != null  and remark2 != ''"> and remark2 = #{remark2}</if>
        </where>
    </select>
    
    <select id="selectAgriWeatherForecastById" parameterType="Long" resultMap="AgriWeatherForecastResult">
        <include refid="selectAgriWeatherForecastVo"/>
        where id = #{id}
    </select>

    <insert id="insertAgriWeatherForecast" parameterType="AgriWeatherForecast" useGeneratedKeys="true" keyProperty="id">
        insert into ld_agri_weather_forecast
        <trim prefix="(" suffix=")" suffixOverrides=",">
