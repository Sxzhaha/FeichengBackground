            <if test="weatherTextDay != null">#{weatherTextDay},</if>
            <if test="weatherTextNight != null">#{weatherTextNight},</if>
            <if test="dayCode != null">#{dayCode},</if>
            <if test="moonCode != null">#{moonCode},</if>
            <if test="forecastType != null">#{forecastType},</if>
            <if test="remark1 != null">#{remark1},</if>
            <if test="remark2 != null">#{remark2},</if>
         </trim>
    </insert>

    <update id="updateAgriWeatherForecast" parameterType="AgriWeatherForecast">
        update ld_agri_weather_forecast
