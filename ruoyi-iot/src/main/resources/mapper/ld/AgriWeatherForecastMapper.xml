    </delete>

    <delete id="deleteAgriWeatherForecastByIds" parameterType="String">
        delete from ld_agri_weather_forecast where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>