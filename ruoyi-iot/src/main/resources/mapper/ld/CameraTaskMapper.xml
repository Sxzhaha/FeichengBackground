<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.iot.ld.mapper.CameraTaskMapper">
    
    <resultMap type="CameraTask" id="CameraTaskResult">
        <result property="taskId"    column="task_id"    />
        <result property="taskName"    column="task_name"    />
        <result property="deviceName"    column="device_name"    />
        <result property="snCode" column="sn_code"/>
        <result property="pointIndex"    column="point_index"    />
        <result property="presetId"    column="preset_id"    />
        <result property="jobType"    column="job_type"    />
        <result property="executeTime"    column="execute_time"    />
        <result property="cronExpression"    column="cron_expression"    />
        <result property="status"    column="status"    />
        <result property="creatorId"    column="creator_id"    />
        <result property="creatorName" column="nick_name" />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="count"    column="count"    />
    </resultMap>

    <sql id="selectCameraTaskVo">
        select task_id, task_name, preset_id, count, job_type, execute_time, cron_expression, ct.status, ct.creator_id, ct.create_time, ct.update_by, ct.update_time, ct.remark,su.nick_name,pp.point_index,d.device_name,d.device_sn sn_code from camera_task ct left join sys_user su on su.user_id = ct.creator_id left join camera_preset pp on pp.id = ct.preset_id left join iot_device d on d.device_id = pp.device_id
    </sql>

    <select id="selectCameraTaskList" parameterType="CameraTask" resultMap="CameraTaskResult">
        <include refid="selectCameraTaskVo"/>
        <where>  
            <if test="taskName != null  and taskName != ''"> and task_name like concat('%', #{taskName}, '%')</if>
            <if test="presetId != null "> and preset_id = #{presetId}</if>
            <if test="jobType != null  and jobType != ''"> and job_type = #{jobType}</if>
            <if test="executeTime != null "> and execute_time = #{executeTime}</if>
            <if test="cronExpression != null  and cronExpression != ''"> and cron_expression = #{cronExpression}</if>
            <if test="status != null  and status != ''"> and ct.status = #{status}</if>
            <if test="creatorId != null  and creatorId != ''"> and ct.creator_id = #{creatorId} </if>
            <if test="count != null  and count != ''"> and count = #{count} </if>
        </where>
    </select>
    
    <select id="selectCameraTaskByTaskId" parameterType="Long" resultMap="CameraTaskResult">
        <include refid="selectCameraTaskVo"/>
        where task_id = #{taskId}
    </select>

    <insert id="insertCameraTask" parameterType="CameraTask" useGeneratedKeys="true" keyProperty="taskId">
        insert into camera_task
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="taskName != null">task_name,</if>
            <if test="presetId != null">preset_id,</if>
            <if test="jobType != null">job_type,</if>
            <if test="executeTime != null">execute_time,</if>
            <if test="cronExpression != null">cron_expression,</if>
            <if test="status != null">status,</if>
            <if test="creatorId != null">creator_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="count != null">count,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="taskName != null">#{taskName},</if>
            <if test="presetId != null">#{presetId},</if>
            <if test="jobType != null">#{jobType},</if>
            <if test="executeTime != null">#{executeTime},</if>
            <if test="cronExpression != null">#{cronExpression},</if>
            <if test="status != null">#{status},</if>
            <if test="creatorId != null">#{creatorId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="count != null">#{count},</if>
         </trim>
    </insert>

    <update id="updateCameraTask" parameterType="CameraTask">
        update camera_task
        <trim prefix="SET" suffixOverrides=",">
            <if test="taskName != null">task_name = #{taskName},</if>
            <if test="presetId != null">preset_id = #{presetId},</if>
            <if test="jobType != null">job_type = #{jobType},</if>
            <if test="executeTime != null">execute_time = #{executeTime},</if>
            <if test="cronExpression != null">cron_expression = #{cronExpression},</if>
            <if test="status != null">status = #{status},</if>
            <if test="creatorId != null">creator_id = #{creatorId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="count != null">count = #{count},</if>
        </trim>
        where task_id = #{taskId}
    </update>

    <delete id="deleteCameraTaskByTaskId" parameterType="Long">
        delete from camera_task where task_id = #{taskId}
    </delete>

    <delete id="deleteCameraTaskByTaskIds" parameterType="String">
        delete from camera_task where task_id in 
        <foreach item="taskId" collection="array" open="(" separator="," close=")">
            #{taskId}
        </foreach>
    </delete>
</mapper>