<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.iot.ld.mapper.IotDeviceLogMapper">
    
    <resultMap type="IotDeviceLog" id="IotDeviceLogResult">
        <result property="logId"    column="log_id"    />
        <result property="deviceSn"    column="device_sn"    />
        <result property="logType"    column="log_type"    />
        <result property="payload"    column="payload"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectIotDeviceLogVo">
        select log_id, device_sn, log_type, payload, create_time from iot_device_log
    </sql>

    <select id="selectIotDeviceLogList" parameterType="IotDeviceLog" resultMap="IotDeviceLogResult">
        <include refid="selectIotDeviceLogVo"/>
        <where>  
            <if test="deviceSn != null  and deviceSn != ''"> and device_sn = #{deviceSn}</if>
            <if test="logType != null "> and log_type = #{logType}</if>
            <if test="payload != null  and payload != ''"> and payload = #{payload}</if>
            <if test="params.beginTime != null and params.beginTime != ''"><!-- 开始时间检索 -->
                and create_time &gt;= #{params.beginTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''"><!-- 结束时间检索 -->
                and create_time &lt;= #{params.endTime}
            </if>
        </where>
    </select>
    <select id="checkLogExists" resultType="int">
        select count(1) from iot_device_log
        <where>
            <if test="deviceSn != null and deviceSn != ''"> and device_sn = #{deviceSn}</if>
            <if test="payload != null and payload != ''"> and payload = #{payload}</if>
            <if test="createTime != null"> and create_time = #{createTime}</if>
        </where>
    </select>
    <select id="selectIotDeviceLogByLogId" parameterType="Long" resultMap="IotDeviceLogResult">
        <include refid="selectIotDeviceLogVo"/>
        where log_id = #{logId}
    </select>
    <select id="selectRecentLogsForApp" resultMap="IotDeviceLogResult">
        <include refid="selectIotDeviceLogVo"/>
        where log_type = 1
        <if test="deviceSn != null and deviceSn != ''">and device_sn = #{deviceSn}</if>
        <if test="beginTime != null">and create_time &gt;= #{beginTime}</if>
        order by create_time desc, log_id desc
        limit #{limit}
    </select>

    <select id="selectLatestIotDeviceLogBySnAndIdentifier" resultMap="IotDeviceLogResult">
        <include refid="selectIotDeviceLogVo"/>
        where device_sn = #{deviceSn}
          and json_valid(payload)
          and json_contains_path(payload, 'one', concat('$.', #{identifier}))
        order by create_time desc, log_id desc
        limit 1
    </select>

    <insert id="insertIotDeviceLog" parameterType="IotDeviceLog" useGeneratedKeys="true" keyProperty="logId">
        insert into iot_device_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deviceSn != null and deviceSn != ''">device_sn,</if>
            <if test="logType != null">log_type,</if>
            <if test="payload != null">payload,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deviceSn != null and deviceSn != ''">#{deviceSn},</if>
            <if test="logType != null">#{logType},</if>
            <if test="payload != null">#{payload},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateIotDeviceLog" parameterType="IotDeviceLog">
        update iot_device_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="deviceSn != null and deviceSn != ''">device_sn = #{deviceSn},</if>
            <if test="logType != null">log_type = #{logType},</if>
            <if test="payload != null">payload = #{payload},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where log_id = #{logId}
    </update>

    <delete id="deleteIotDeviceLogByLogId" parameterType="Long">
        delete from iot_device_log where log_id = #{logId}
    </delete>

    <delete id="deleteIotDeviceLogByLogIds" parameterType="String">
        delete from iot_device_log where log_id in 
        <foreach item="logId" collection="array" open="(" separator="," close=")">
            #{logId}
        </foreach>
    </delete>
</mapper>
